# Copy to .env.local for development. Never commit real values.
# Server-only: base URL of the ASP.NET Core API (the browser never calls it directly).
API_BASE_URL=http://localhost:5080
# Public origin of this app; mutating BFF requests must come from it (CSRF protection).
APP_ORIGIN=http://localhost:3000
# Secure cookies (with __Host- prefix). Defaults to true when NODE_ENV=production.
COOKIE_SECURE=false
# Default UI locale: az | tr | en (az = Azerbaijani, the market language)
NEXT_PUBLIC_DEFAULT_LOCALE=az
# IANA time zone used to display order/registration times (must match the API Marketplace:TimeZone).
NEXT_PUBLIC_MARKET_TIME_ZONE=Asia/Baku
