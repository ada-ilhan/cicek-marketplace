# Copy to deploy/.env (git-ignored) and replace every value. Never commit real secrets.
# Oracle passwords: letters, digits and _ only (no double quotes).
ORACLE_ADMIN_PASSWORD=change_me_sys_password
CICEK_OWNER_PASSWORD=change_me_owner_password
CICEK_APP_PASSWORD=change_me_app_password
# At least 32 random characters, e.g. `openssl rand -base64 48`.
JWT_SIGNING_KEY=change_me_to_a_long_random_secret_of_at_least_32_chars
# Optional: pin the Oracle Database Free image tag (e.g. latest-lite).
ORACLE_IMAGE_TAG=latest
# Optional: sign-in/registration requests per minute per IP (default 10). Raise only for automated e2e runs.
# AUTH_RATE_LIMIT=10
# Optional overrides (defaults shown). Useful for running a second, isolated stack: docker compose -p <name> ...
# ORACLE_HOST_PORT=1522
# API_HOST_PORT=5080
# STOREFRONT_HOST_PORT=3000
# APP_ORIGIN=http://localhost:3000   # must match the storefront's public origin (CSRF check)
# Oracle Database XE 21c instead of Free: ORACLE_IMAGE=container-registry.oracle.com/database/express:21.3.0-xe and ORACLE_PDB=XEPDB1
# ORACLE_IMAGE=
# ORACLE_PDB=FREEPDB1
