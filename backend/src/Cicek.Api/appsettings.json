{
  "Database": {
    "DataSource": "localhost:1521/XEPDB1",
    "UserId": "CICEK_APP",
    "Schema": "CICEK_OWNER",
    "MinPoolSize": 1,
    "MaxPoolSize": 50,
    "ConnectionTimeoutSeconds": 15,
    "CommandTimeoutSeconds": 30,
    "ConnectionLifetimeSeconds": 1800
  },
  "Auth": {
    "Jwt": {
      "Issuer": "cicek-api",
      "Audience": "cicek-clients",
      "AccessTokenLifetime": "00:10:00"
    },
    "RefreshTokens": {
      "TokenLifetime": "14.00:00:00",
      "FamilyLifetime": "30.00:00:00"
    }
  },
  "Media": {
    "Provider": "None",
    "MaxBytes": 5000000,
    "MaxImagesPerShop": 300
  },
  "Marketplace": {
    "Currency": "AZN",
    "TimeZone": "Asia/Baku",
    "DefaultCommissionRateBps": 1500,
    "DeliveryFeePerOrder": 49.90,
    "MaxDeliveryDaysAhead": 30,
    "PaymentTimeout": "02:00:00",
    "ImageHostAllowlist": [],
    "AllowAnyExternalImageHost": false
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ReverseProxy": {
    "KnownProxies": []
  },
  "RateLimiting": {
    "AuthPermitsPerMinute": 10,
    "GlobalPermitsPerMinute": 600
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
