<Project Sdk="Microsoft.NET.Sdk">
  <!-- Explicit deployment tool: applies EF Core migrations as the schema owner, grants runtime privileges, seeds roles. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UserSecretsId>cicek-dbmigrator-dev</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Cicek.Infrastructure\Cicek.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Cicek.Infrastructure.Tests" />
  </ItemGroup>
</Project>
